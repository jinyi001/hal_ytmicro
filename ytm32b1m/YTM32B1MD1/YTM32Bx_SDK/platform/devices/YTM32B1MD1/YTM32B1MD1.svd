                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1 byte</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>2 bytes</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>3 bytes</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>4 bytes</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>5 bytes</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>6 bytes</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>7 bytes</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>8 bytes</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>9 bytes</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>10 bytes</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11</name>
                  <description>11 bytes</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>12 bytes</description>
