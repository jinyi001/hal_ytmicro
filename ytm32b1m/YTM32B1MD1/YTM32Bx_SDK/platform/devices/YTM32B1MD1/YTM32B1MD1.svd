            <field>
              <name>QDDIR</name>
              <description>Indicate quadrature decoder counter direction.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Quadrature counter increase.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Quadrature counter decrease.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>QDTOF</name>
              <description>When STS[QDTOF]=1, STS[QDDIR]=0, means quadrature decoder counter increase to 0xFFFF, then overflow to 0. When STS[QDTOF]=1, STS[QDDIR]=1, means quadrature decoder counter decrease to 0, then overflow to 0xFFFF. Write 1 to clear the bit.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TOF</name>
              <description>Timer overflow flag sets when counter increase from MOD[MOD] to 0. Write 1 to clear the bit.</description>
