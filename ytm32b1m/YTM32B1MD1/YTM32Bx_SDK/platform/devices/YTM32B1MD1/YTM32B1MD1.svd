                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>Divide by 9</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>Divide by 10</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>Divide by 11</description>
                  <value>10</value>
