          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CVAL</name>
              <description>This register stands for current timer value when user read this register. The value of this register will be frozen in debug mode if MCR[FRZ] is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

