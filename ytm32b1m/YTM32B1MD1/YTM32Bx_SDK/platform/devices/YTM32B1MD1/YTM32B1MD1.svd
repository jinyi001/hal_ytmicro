        <register>
        <name>CH0_PPCNTN</name>
          <description>Positive pulse timeout flag number register.</description>
          <addressOffset>0x98</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PPCNTN</name>
              <description>Positive pulse width measurement counter period number.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CH0_PPCNTV</name>
          <description>Positive pulse width capture value register.</description>
          <addressOffset>0x9c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PPCNTV</name>
              <description>Positive pulse width measurement capture counter value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
