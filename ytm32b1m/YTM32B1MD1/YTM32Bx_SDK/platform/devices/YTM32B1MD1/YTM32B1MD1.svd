          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>STLOFF</name>
              <description>Source address will add offset value(support signed-short type) after DMA channel trigger loop completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTS4_DADDR</name>
          <description></description>
          <addressOffset>0x490</addressOffset>
          <size>32</size>
          <access>read-write</access>
