                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Channel interrupt is asserted.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

