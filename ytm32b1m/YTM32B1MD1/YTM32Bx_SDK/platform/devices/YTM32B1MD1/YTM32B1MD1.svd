           <fields>
            <field>
              <name>SADDR</name>
              <description>Source address of DMA transfer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTS4_SOFF</name>
          <description></description>
          <addressOffset>0x484</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SOFF</name>
              <description>Source address will add offset value(support signed-short type) after each DMA transfer size completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTS4_TCR</name>
          <description></description>
          <addressOffset>0x486</addressOffset>
