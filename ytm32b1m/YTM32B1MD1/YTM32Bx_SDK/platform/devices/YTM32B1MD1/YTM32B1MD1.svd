        <name>IFCR14</name>
          <description>There is an Identifier Filter Control Register (IFCRn) for each filter. \newline Even-numbered instances of IFCRn (IFCR0, IFCR2, IFCR4, and so on) act as filters in both identifier list and identifier mask modes. \newline Odd-numbered instances of IFCRn (IFCR1, IFCR3, IFCR5, and so on) act as: \begin{itemize}[] \item Filters in identifier list mode. \item A mask for the preceding-numbered register in identifier mask mode. For example, if filters 0 and 1 are configured for identifier mask mode, IFCR1 acts as a mask for IFCR0. \end{itemize} The IFCRn registers are read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFL</name>
              <description>Number of data bytes in the response part of the frame. \newline DFL = Number of data bytes - 1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIR</name>
              <description>Controls the direction of the data field.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copy it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA register.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>Identifier part of the identifier field without the identifier parity.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFCR15</name>
          <description>There is an Identifier Filter Control Register (IFCRn) for each filter. \newline Even-numbered instances of IFCRn (IFCR0, IFCR2, IFCR4, and so on) act as filters in both identifier list and identifier mask modes. \newline Odd-numbered instances of IFCRn (IFCR1, IFCR3, IFCR5, and so on) act as: \begin{itemize}[] \item Filters in identifier list mode. \item A mask for the preceding-numbered register in identifier mask mode. For example, if filters 0 and 1 are configured for identifier mask mode, IFCR1 acts as a mask for IFCR0. \end{itemize} The IFCRn registers are read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFL</name>
              <description>Number of data bytes in the response part of the frame. \newline DFL = Number of data bytes - 1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIR</name>
              <description>Controls the direction of the data field.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copy it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA register.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>Identifier part of the identifier field without the identifier parity.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>GCR</name>
          <description>The GCR register contains control bits that apply to both LIN and UART modes. \newline The GCR register is read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x8c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SLPRE</name>
              <description>When this bit is set, the receiving data will be stored in LINFlexD buffer while the system is in sleep/deepsleep mode. It is valid only if LINFlexD is running (Normal mode) when system is in sleep/deepsleep mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SWPC</name>
              <description>Controls the direction switch between RX pin and TX pin.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>RX pin is working for reception, TX pin is working for transmission.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>RX pin is working for transmission, TX pin is working for reception.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TDFBM</name>
              <description>Controls whether the first bit of transmit data (payload only) is the most or least significant bit from the respective buffer data register.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>The first bit of transmitted data is the least significant bit of the buffer data register (DATA0[0], DATA1[0], DATA2[0], DATA3[0], DATA4[0], DATA5[0], DATA6[0], DATA7[0]).</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The first bit of transmitted data is the most significant bit of the buffer data register (DATA0[7], DATA1[7], DATA2[7], DATA3[7], DATA4[7], DATA5[7], DATA6[7], DATA7[7]).</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RDFBM</name>
              <description>Controls whether the first bit of received data (payload only) is mapped to the most or least significant bit from the respective buffer data register.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>The first bit of received data is mapped to least significant bit of the buffer data register (DATA0[0], DATA1[0], DATA2[0], DATA3[0], DATA4[0], DATA5[0], DATA6[0], DATA7[0]).</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The first bit of received data is mapped to the most significant bit of the buffer data register (DATA0[7], DATA1[7], DATA2[7], DATA3[7], DATA4[7], DATA5[7], DATA6[7], DATA7[7]).</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TDLIS</name>
              <description>Controls the data inversion of transmitted data (payload only).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Transmitted data is not inverted.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Transmitted data is inverted.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RDLIS</name>
              <description>Controls the data inversion of received data (payload only).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Received data is not inverted.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Received data is inverted.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STOP</name>
              <description>Controls the number of stop bits transmitted for all fields (delimiter, sync, ID, checksum, payload).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>One stop bit.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Two stop bits.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SR</name>
              <description>Writing ‘1’ to SR executes a soft reset of the LINFlexD (FSMs, FIFO pointers, counters, timers, status and error registers) without modifying the configuration registers. SR should be cleared by software to perform further operations (SR is not cleared by hardware).  \newline The SR bit can be written only be software in Initialization mode. The read value of SR is always ‘0’.  \newline When writing ‘1’ to SR, below register fields are reset:</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>UARTPTO</name>
          <description>The UARTPTO register contains the preset value of the timeout register in UART mode and is programmed according to the number of bits to be received or to monitor the idle state of the reception line. The UARTPTO register can be written by software at any time.</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000fff</resetValue>
           <fields>
            <field>
              <name>PTO</name>
              <description>PTO defines the preset value of timeout counter. A zero value is forbidden; otherwise, the UARTSR[TO] status bit is immediately set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>UARTCTO</name>
          <description>The UARTCTO register contains the current timeout value in UART mode. UARTCTO is used with the UARTPTO register to monitor the number of bits received by UART or to monitor the idle state of the reception line.  \newline UART timeout works in both CPU and DMA modes. \newline The timeout counter: \begin{itemize}[] \item Starts at zero and counts upward. \item Is clocked with ipg_baud_clk / (16 * LDIV) synchronized to bus clock (when UARTCR.ROSE = 0). \item Is clocked with ipg_baud_clk / (UARTCR.OSR * LINIBRR.IBR) synchronized to bus clock (when UARTCR.ROSE = 1). \item Is automatically enabled when UARTCR.RXEN = 1. \end{itemize} \note{Due to synchronization, there is a delay between 4 to 6 clock cycles of bus clock for the internal value (which is clocked with ipg_baud_clk/16 * LDIV) to reflect on UARTCTO.} \newline The timeout counter is reset when one of the following conditions occurs: \begin{itemize}[] \item The number of frames received is equal to UARTCR.NEF. \item UARTCTO becomes equal to UARTPTO. \item UARTPTO is written. \item UARTSR.DRF is set and UARTCR.DTU = 1. \end{itemize} \newpage</description>
          <addressOffset>0x94</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CTO</name>
              <description>CTO defines the current value of the timeout counter. CTO is a read-only field. CTO is reset every time UARTPTO is written, or UARTCTO = UARTPTO, or by hard/soft reset. When the CTO value matches the preset value (UARTPTO.PTO), the status bit UARTSR.TO is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>DMATXE</name>
          <description>The DMATXE register enables the DMA Tx interface. The DMATXE register can be written by software at any time. When DMATXE = 0x0000_0000, the DMA Tx interface FSM is forced (by soft reset) into the Idle state. \note{When configuration parameter DMA_SUPPORTED = 0, the LINFlexD does not support DMA operation. The DMATXE register is invalid and must be written only with value 0x0000_0000.}</description>
          <addressOffset>0x98</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DTE</name>
              <description>\begin{itemize}[] \item 0 = DMA Tx channel n is disabled. \item 1 = DMA Tx channel n is enabled. \end{itemize}</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>DMARXE</name>
          <description>The DMARXE register enables the DMA Rx interface. The DMARXE register can be written by software at any time. When DMARXE = 0x0000_0000, the DMA Rx interface FSM is forced (by soft reset) into the Idle state. \note{When configuration parameter DMA_SUPPORTED = 0, the LINFlexD does not support DMA operation. The DMARXE register is invalid and must be written only with value 0x0000_0000.}</description>
          <addressOffset>0x9c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DRE</name>
              <description>\begin{itemize}[] \item 0 = DMA Rx channel n is disabled. \item 1 = DMA Rx channel n is enabled. \end{itemize}</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>
    <peripheral>
      <name>LINFlexD1</name>
      <description></description>
      <groupName>LINFlexD</groupName>
      <prependToName>LINFlexD1_</prependToName>
      <baseAddress>0x4001C000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>160</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>LINCR1</name>
          <description>The LINCR1 register consists of control bits used to configure features of the LINFlexD. \note{When accessing the LINCR1 register, each reserved bit should be written with its original reset value.}</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000082</resetValue>
           <fields>
            <field>
              <name>NLSE</name>
              <description>NLSE enables/disables capture of the LIN state (LINSR.LINS) whenever a bit error flag occurs (LINESR.BEF is set to 1).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINSR.LINS shows the current LIN state and does not capture the LIN state on bit error.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINSR.LINS is captured when a bit error flag occurs.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCD</name>
              <description></description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Checksum calculation is done by hardware. The LINCFR register is read-only.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Checksum calculation is disabled. The LINCFR register is read/write. If the checksum field is enabled (CFD = 0), LINCFR can be programmed to send a software-calculated checksum/CRC.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFD</name>
              <description></description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Checksum field is sent after the required number of data bytes are sent.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>No checksum field is sent in the frame.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LASE</name>
              <description>Enables the autosynchronization, feature described in “Automatic Resynchronization”.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable autosynchronization.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable autosynchronization.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUTOWU</name>
              <description></description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>The SLEEP bit is cleared by software only.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The SLEEP bit is cleared by hardware whenever the LINSR.WUF bit is set.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MBL</name>
              <description>Controls the length of the break field generated in LIN master mode.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>10-bit break length</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>11-bit break length</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>12-bit break length</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>13-bit break length</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>14-bit break length</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>15-bit break length</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>16-bit break length</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>17-bit break length</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>18-bit break length</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>19-bit break length</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>20-bit break length</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11</name>
                  <description>21-bit break length</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>22-bit break length</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>13</name>
                  <description>23-bit break length</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>14</name>
                  <description>36-bit break length</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>15</name>
                  <description>50-bit break length</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BF</name>
              <description>Controls the receive filter bypass function.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Receiver ignores incoming frame if ID does not match any ID filter or if no ID filters are active.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>If no ID filters are active, receiver responds to incoming frames. If ID filters are active, receiver responds if frame is received but does not match any filter.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LBKM</name>
              <description>Enables or disables Loop Back mode as described in “Loop Back Mode”.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable Loop Back mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable Loop Back mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MME</name>
              <description></description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Slave mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Master mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SSBL</name>
              <description>Sets the number of bit times for break field detection in slave mode.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>11-bit break length.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>10-bit break length.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RBLM</name>
              <description></description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Receiver is buffer is not locked. The next incoming message overwrites the previous one.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Receiver buffer is locked against overrun. Once the buffer is full, the next incoming message is discarded if the buffer is not released by software clearing the LINSR.RMB bit.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SLEEP</name>
              <description>Set by software to request LINFlexD to enter Sleep mode.  \newline The SLEEP bit is cleared by software to exit sleep mode. \newline If LINCR1.AUTOWU and LINSR.WUF are set, SLEEP is automatically cleared by hardware to exit sleep mode. \newline SLEEP is effective in both LIN and UART modes.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INIT</name>
              <description>Set by software to switch the hardware into Initialization mode.  \newline When software clears the INIT bit (and if the SLEEP bit is also 0), the LINFlexD enters Normal mode. \newline INIT is effective in both LIN and UART modes.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINIER</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>REDIE</name>
              <description></description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Receive Edge Detection Flag (REDF) is set in LINSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SZIE</name>
              <description></description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Stuck at Zero Flag (SZF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OCIE</name>
              <description></description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Output Compare Flag (OCF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BEIE</name>
              <description></description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Bit Error Flag (BEF) is set in LINESR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CEIE</name>
              <description></description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Checksum Error Flag (CEF) is set in LINESR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HEIE</name>
              <description></description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the any of the following flags are set in LINESR: SFEF, SDEF, IDPEF.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FEIE</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Frame Error Flag (FEF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BOIE</name>
              <description></description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated when the Buffer Overrun Flag (BOF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LSIE</name>
              <description></description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt generated on entering the following states: Sync Del, Sync Field, Identifier Field, Checksum.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUIE</name>
              <description></description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt generated when the Wakeup Flag (WUF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TOIE</name>
              <description></description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt generated when the LINFlexD is in UART mode and the Timeout bit (TO) is set in UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DRIE</name>
              <description></description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt generated when the Data Received Flag (DRF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTIE</name>
              <description></description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt generated when the Data Transmitted Flag (DTF) is set in LINESR or UARTSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HRIE</name>
              <description></description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enabled. An interrupt is generated Header Received Flag (HRF) is set in LINSR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>LINSR</name>
          <description>The LINSR register contains status bits indicating the state of the LINFlexD hardware. \note{Reset value of RDI reflects the LINFlexD_RX pin state.}</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000040</resetValue>
           <fields>
            <field>
              <name>REDF</name>
              <description>REDF is set by hardware when receiving falling edge is detected.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTOSYNC_COMP</name>
              <description>AUTOSYNC_COMP is set when autosynchronization is enabled (LINCR1.LASE is set) and autosynchronization is complete. After AUTOSYNC_COMP is set, the contents of LINIBRR and LINFBRR registers can be read.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RDC</name>
              <description>RDC contains the number of entries (bytes) in the receive data buffer in LIN mode.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>1 byte</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>2 bytes</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>3 bytes</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>4 bytes</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>5 bytes</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>6 bytes</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>7 bytes</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>8 bytes</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LINS</name>
              <description></description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RMB</name>
              <description></description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Buffer is free.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Buffer data is ready to be read by software. RMB should be cleared by software after reading the data received in the buffer.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DRBNE</name>
              <description>DRBNE is set by hardware as soon as the first byte of response is received and stored in DATA (when there is at least one data byte in reception buffer). Software should clear DRBNE after reading all the buffers. \newline DRBNE can be checked by software in the case of a response timeout event. \newline DRBNE is cleared by hardware in Initialization mode.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXBUSY</name>
              <description></description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Receiver is idle.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Reception is ongoing.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RDI</name>
              <description>Indicates the current state of the LINFlexD_RX pin. \note{After reset is released, RDI reflects the actual value of the LINFlexD_RX pin.}</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WUF</name>
              <description>WUF is set by hardware when a falling edge is detected on the LINFlexD_RX pin in either of the following conditions: \begin{itemize}[] \item The LINFlexD is in slave mode and in Sleep mode. \item The LINFlexD is in master mode is in either Sleep mode or Idle state. \end{itemize} WUF is cleared by hardware in Initialization mode.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DRF</name>
              <description>DRF is set by hardware and indicates that data reception has completed. \newline DRF is cleared by hardware in Initialization mode. \note{DRF is not set when a framing error or checksum error occurs.}</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DTF</name>
              <description>DTF is set by hardware and indicates that data transmission has completed. \newline DTF is cleared by hardware in Initialization mode. \note{DTF is not set in LIN mode when a bit error occurs and LINCR2.IOBE = 0.}</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HRF</name>
              <description>HRF is set by hardware when header reception completes and one of the following conditions is true. \begin{itemize}[] \item All filters are inactive and LINCR1.BF = 1. \item No match in any filter and LINCR1.BF = 1. \item Tx filter match. \end{itemize} HRF is reset by hardware in Initialization mode and at end of completed or aborted frame.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINESR</name>
          <description>The LINESR register contains status bits for various error conditions. For detailed descriptions the error conditions, see \hyperlink{errors}{“Errors”}.</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SZF</name>
              <description>Set by hardware when a stuck-at-zero timeout error occurs.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OCF</name>
              <description>In master mode, OCF is set when counter LINTCSR.CNT matches the content of LINOCR.OC2. \newline In slave mode, OCF is set when the content of the counter LINTCSR.CNT matches the content of LINOCR.OC1 or LINOCR.OC2. \newline If OCF is set when LINTCSR.MODE = 0 and LINTCSR.IOT = 1, the LINFlexD goes to Idle state. \newline When LINTCSR.MODE = 0, OCF is cleared by hardware in Initialization mode. \newline When LINTCSR.MODE = 1, OCF maintains its status regardless of the LIN state.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BEF</name>
              <description>BEF is set by hardware when the LINFlexD detects a bit error. \newline BEF is cleared by hardware in Initialization mode.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CEF</name>
              <description>CEF is set by hardware when the received checksum does not match the hardware calculated checksum. \newline CEF is cleared by hardware in Initialization mode. \note{CEF is never set if LINCR1.CCD or LINCR1.CFD is set.}</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SFEF</name>
              <description>SFEF is set by hardware when a sync field error occurs due to an inconsistent sync field. \newline SFEF is cleared by hardware in Initialization mode.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SDEF</name>
              <description>SDEF is set by hardware when a break delimiter error occurs because a break delimiter is too short (less than one bit time). \newline SDEF is cleared by hardware in Initialization mode.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IDPEF</name>
              <description>IDPEF is set by hardware LINFlexD detects an error in the ID parity. \newline IDPEF is cleared by hardware in Initialization mode.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FEF</name>
              <description>FEF is set by hardware when a framing error (invalid stop bit) occurs. \newline FEF is cleared by hardware in Initialization mode.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BOF</name>
              <description>BOF is set by hardware when a new byte is received and LINSR.RMB bit is not cleared. \newline BOF is cleared by hardware in Initialization mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NF</name>
              <description>NF is set by hardware when noise is detected in a receive character. \newline NF is cleared by hardware in Initialization mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>UARTCR</name>
          <description>The UARTCR register contains control bits for UART mode. \note{Always write ‘0’ to reserved bits when writing to UARTCR.} \note{In UART mode, the LINFlexD does not support communication with Special Word Length (UARTCR.WLS = 1) in buffer mode.} \note{In UART mode, the LINFlexD supports communication with Special Word Length (UARTCR.WLS = 1) in FIFO mode only with UARTCR.WL[1:0] = 11.}</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>MIS</name>
              <description></description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>UARTCTO monitors the number of bits to be received.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>UARTCTO monitors the idle state of the reception line.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CSP</name>
              <description>The CSP bits select the sample point during reduced oversampling. \newline CSP can have the following range of values for the specified oversampling rate:</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OSR</name>
              <description>Selects the number of samples taken for a bit when reduced oversampling is enabled. \newline The values allowed for OSR are 4, 5, 6, and 8. \note{When idle state monitoring is enabled (MIS = 1), the allowed OSR values are 4 and 8.} OSR can be read in any mode, but can be written only during Initialization mode.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ROSE</name>
              <description></description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Each bit is oversampled sixteen times.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>OSR bits determine the oversampling rate.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEF</name>
              <description>The NEF bits set the number of expected frames in UART reception mode. If the DTU bit is set, then the UART timeout counter is reset after the configured number of frames have been received.  \newline NEF can be read in any mode, but can be written only during Initialization mode.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DTU</name>
              <description></description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Timeout must be handled by software.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Timeout in UART mode is disabled after the configured number of data frames are received.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SBUR</name>
              <description></description>
              <bitOffset>17</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>1 stop bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>2 stop bits</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>3 stop bits</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WLS</name>
              <description></description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable 12-bit + parity bit in reception.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable 12-bit + parity bit in reception (UART mode).</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TDFL_TFC</name>
              <description>The TDFL_TFC field has one of two functions depending on the mode of operation. \newline \textbf{UART Buffer Mode:} \newline When the LINFlexD is in UART buffer mode (TFBM = 0), TDFL_TFC is read/write and defines the number of bytes to be transmitted. \begin{itemize}[] \item x00:  1 byte \item x01:  2 bytes \item x10:  3 bytes \item x11:  4 bytes \end{itemize} The first bit is reserved and not implemented.  \newline When the UART data length is configured as half-word (WL = 10 or 11), the only valid values for TDFL_TFC are x01 and x11. \newline \textbf{UART FIFO Mode:} \newline When the LINFlexD is in UART FIFO mode (TFBM = 1), TDFL_TFC is read-only and contains the number of entries (bytes) in the Tx FIFO. \begin{itemize}[] \item 000:  Empty \item 001:  1 byte \item 010:  2 bytes \item 011:  3 bytes \item 100:  4 bytes \item All other values: Reserved \end{itemize} TDFL_TFC can be read in any mode, but can be written only during Initialization mode, when the UART bit is set.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RDFL_RFC</name>
              <description>The RDFL_RFC field has one of two functions depending on the mode of operation. \newline \textbf{UART Buffer Mode:} \newline When the LINFlexD is in UART buffer mode (RFBM = 0), RDFL_RFC is read/write and defines the number of bytes to be received: \begin{itemize}[] \item x00:  1 byte \item x01:  2 bytes \item x10:  3 bytes \item x11:  4 bytes \end{itemize} The first bit is reserved and not implemented.  \newline When the UART data length is configured as half-word (WL = 10 or 11), the only valid values for RDFL_RFC are x01 and x11. \newline RDFL_RFC should be programmed to be greater than or equal to NEF (number of expected frames). \newline \textbf{UART FIFO Mode:} \newline When the LINFlexD is in UART FIFO mode (RFBM = 1), RDFL_RFC is read-only and contains the number of entries (bytes) in the Rx FIFO: \begin{itemize}[] \item 000:  Empty \item 001:  1 byte \item 010:  2 bytes (1.5 byte if WLS = 1) \item 011:  3 bytes \item 100:  4 bytes (2x1.5 bytes if WLS = 1) \item All other values: Reserved \end{itemize} RDFL_RFC can be read in any mode, but can be written only during Initialization mode, when the UART bit is set.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RFBM</name>
              <description></description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Rx buffer mode enabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Rx FIFO mode enabled (mandatory in DMA Rx mode).</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TFBM</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Tx buffer mode enabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Tx FIFO mode enabled (mandatory in DMA Tx mode).</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WL1</name>
              <description></description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PC1</name>
              <description></description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RxEn</name>
              <description></description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Receiver disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Receiver enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TxEn</name>
              <description></description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Transmitter disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Transmitter enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PC0</name>
              <description></description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PCE</name>
              <description></description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Parity transmit/check disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Parity transmit/check enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WL0</name>
              <description></description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UART</name>
              <description></description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LIN mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>UART mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>UARTSR</name>
          <description>The UARTSR register contains status bits for UART mode.</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SZF</name>
              <description>SZF is set by hardware when 100 dominant bits are detected. An interrupt is generated if LINIER.SZIE = 1. \newline SZF reflects the same value as LINESR.SZF when the LINFlexD is not in Initialization mode and UARTCR.UART = 1.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OCF</name>
              <description></description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No output compare event occurred.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The content of the timeout counter matched the content of LINOCR.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PE</name>
              <description>Indicates parity error in corresponding receive data byte.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No parity error detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Parity error detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RMB</name>
              <description></description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Buffer is free.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Buffer data is ready to be read by software.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FEF</name>
              <description>FEF is set by hardware when the LINFlexD detects a framing error (invalid stop bit). An interrupt is generated if LINIER.FEIE = 1.  \newline FEF reflects the same value as LINESR.FEF when the LINFlexD is not in Initialization mode and UARTCR.UART = 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BOF</name>
              <description>In UART buffer mode, BOF is set by hardware when there is a new byte received and the RMB bit is not cleared. If LINCR.RBLM = 1, the newly received message is discarded. If LINCR.RBLM = 0, the newly received message overwrites the buffer.  \newline In UART FIFO mode, BOF is set when there is a new byte received and the Rx FIFO is full. In UART FIFO mode, once Rx FIFO is full, the new received message is discarded regardless of the value of the RBLM bit. \newline When BOF is set, an interrupt is generated if LINIER.BOIE = 1.  \newline BOF reflects the same value as LINESR.BOF when the LINFlexD is not in Initialization mode and UARTCR.UART = 0.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RDI</name>
              <description>Reflects the current state of the LINFlexD_RX pin when UARTCR.UART = 1</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WUF</name>
              <description>WUF is set by hardware when a falling edge is detected on the LINFlexD_RX pin in Sleep mode. An interrupt is generated if LINIER.WUIE = 1. \newline WUF reflects the same value as LINSR.WUF when the LINFlexD is not in Initialization mode and UARTCR.UART = 1.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RFNE</name>
              <description>RFNE is set by hardware in UART FIFO mode (RFBM = 1), when there is at least one data byte present in the receive FIFO. RFNE is a read-only bit for debugging purposes. \newline RFNE can be used by software in case of a timeout event.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TO</name>
              <description>TO is set by hardware when a UART timeout occurs — in other words, the value of UARTCTO becomes equal to the preset value of the timeout (UARTPTO register setting). An interrupt is generated if LINIER.TOIE = 1. \newline The GCR.SR bit should be used to reset the receiver FSM to the Idle state in the event of timeout for UART reception in both UART buffer and UART FIFO modes.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DRF_RFE</name>
              <description>The DRF_RFE bit function depends on whether the LINFlexD is operating in UART buffer mode or UART FIFO mode. \newline \textbf{UART Buffer Mode:} \newline In UART buffer mode (RFBM = 0), the DRF (data received flag) function of DRF_RFE is used. DRF is set by hardware in UART buffer mode when the number of bytes programmed in UARTCR.RDFL are received. An interrupt is generated if LINIER.DRIE = 1. \newline DRF is set when the configured number of valid stop bits are received for the last frame. \newline DRF is set regardless of parity error, overrun error, or framing error if the framing error is in the last STOP bit configured. \newline DRF reflects the same value as LINSR.DRF when the LINFlexD is not in Initialization mode and UARTCR.UART = 1. \newline DRF can be read/cleared by software. Writing ‘1’ clears DRF.  \newline \textbf{UART FIFO Mode:} \newline In UART FIFO mode (RFBM = 1), the RFE (Rx FIFO empty) function of DRF_RFE is used. RFE is set by hardware in UART FIFO mode when the Rx FIFO is empty.  \newline RFE is a read-only bit for debugging purposes. It is internally used by the DMA Rx interface.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DTF_TFF</name>
              <description>The DTF_TFF bit function depends on whether the LINFlexD is operating in UART buffer mode or UART FIFO mode.  \newline \textbf{UART Buffer Mode:} \newline In UART buffer mode (RFBM = 0), the DTF (data transmitted flag) function of DTF_TFF is used. DTF is set by hardware in UART buffer mode when data transmission completes. An interrupt is generated if LINIER.DTIE = 1. \newline DTF reflects the same value as LINSR.DTF when the LINFlexD is not in Initialization mode and UARTCR.UART = 1. \newline DTF can be read/cleared by software. Writing ‘1’ clears DTF.  \newline \textbf{UART FIFO Mode:} \newline In UART FIFO mode (RFBM = 1), the TFF (Tx FIFO full) function of DTF_TFF is used. TFF is set by hardware in UART FIFO mode when Tx FIFO is full.  \newline TFF is a read-only bit for debugging purposes. It is internally used by the DMA Tx interface.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NF</name>
              <description>Set by hardware when noise is detected in the received character. \newline NF reflects the same value as LINESR.NF when the LINFlexD is not in Initialization mode and the UARTCR.UART = 1.  \newline During reduced oversampling (UARTCR.ROSE = 1), the NF bit is enabled only when UARTCR.OSR = 8.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINTCSR</name>
          <description>The LINTCSR register contains control and status bits for the LIN timeout feature. \note{When LINTCSR.MODE = 0, any activity on the transmit or receive pins will cause an unwanted change in the value of the 8-bit field Output Compare Value 2 (OC2) of the LIN Output Compare register (LINOCR). If the LINFlexD is enabled in LIN mode and the value of LINTCSR.MODE is changed from ‘1’ to ‘0’, the old values of LINOCR.OC1 and LINOCR.OC2 are retained. As a consequence, if the LINFlexD is reconfigured from UART mode to LIN mode, or LINTCSR.MODE is changed from ‘1’ to ‘0’, an incorrect timeout exception is generated when a LIN communication starts. To avoid this, set LINTCSR.MODE to ‘1’, reconfigure the LINFlexD in LIN mode, then reset LINTCSR.MODE to ‘0’. Before switching LINTCSR.MODE from ‘1’ to ‘0’ between frames, load LINOCR with 0xFFFF.}</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
           <fields>
            <field>
              <name>MODE</name>
              <description></description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LIN mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Output compare mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IOT</name>
              <description></description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LIN state machine does not reset to Idle on timeout.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LIN state machine resets to Idle on timeout event.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TOCE</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Timeout counter disabled. UARTSR.OCF flag is not set on an output compare event.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Timeout counter enabled. UARTSR.OCF is set if an output compare event occurs.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CNT</name>
              <description>The value of the timeout counter. \note{For proper functionality of this counter, LINIBRR should be greater than or equal to 5.}</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINOCR</name>
          <description>The LINOCR register contains the value to be compared to the LINTCSR.CNT value. \newline LINOCR is writable by software only in when the counter is in output compare mode.</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000ffff</resetValue>
           <fields>
            <field>
              <name>OC2</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OC1</name>
              <description></description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINTOCR</name>
          <description>The LINTOCR register contains the LIN mode response and header timeout values.</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000e2c</resetValue>
           <fields>
            <field>
              <name>RTO</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HTO</name>
              <description>HTO specifies the header timeout duration (in bit time). HTO can be written only for slave mode. The header timeout should be programmed without considering 11 bits of break field.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINFBRR</name>
          <description>LINFBRR sets the fractional part of the LIN baud rate, as described in \hyperref[baud-rate-generation]{Baud Rate Generation}. \note{When LINCR1.LASE = 1, LINFBRR should be read only after LINSR.AUTOSYNC_COMP is set to obtain the correct value.} \note{LINFBRR cannot be used when reduced oversampling is enabled (UARTCR.ROSE = 1).}</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>FBR</name>
              <description></description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Fraction(LDIV) = 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Fraction(LDIV) = 1/16</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Fraction(LDIV) = 2/16</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Fraction(LDIV) = 3/16</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>Fraction(LDIV) = 4/16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>Fraction(LDIV) = 5/16</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>Fraction(LDIV) = 6/16</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>Fraction(LDIV) = 7/16</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>Fraction(LDIV) = 8/16</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>Fraction(LDIV) = 9/16</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>Fraction(LDIV) = 10/16</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11</name>
                  <description>Fraction(LDIV) = 11/16</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>Fraction(LDIV) = 12/16</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>13</name>
                  <description>Fraction(LDIV) = 13/16</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>14</name>
                  <description>Fraction(LDIV) = 14/16</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>15</name>
                  <description>Fraction(LDIV) = 15/16</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>LINIBRR</name>
          <description>LINIBRR sets the integer part of the LIN baud rate, as described in \hyperref[baud-rate-generation]{Baud Rate Generation}. \note{When LINCR1.LASE = 1, LINIBRR should be read only after LINSR.AUTOSYNC_COMP is set to obtain the correct value.}</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>IBR</name>
              <description>The IBR bits, along with the fractional baud rate bits in LINFBRR, set the LIN baud rate. \begin{itemize}[] \item IBR = 0x0:  LIN clock disabled \item IBR = 0x1:  Mantissa(LDIV) = 1 \item ... \item IBR = 0xFFFFE:  Mantissa(LDIV) = 1048574 \item IBR = 0xFFFFF:  Mantissa(LDIV) = 1048575 \end{itemize} IBR can be read in any mode, but can be written only during Initialization mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINCFR</name>
          <description>\note{There is a delay between 4 to 6 clock cycles of bus clock for the internal checksum’s value (which is clocked with ipg_baud_clk/16 * LDIV) to reflect on LINCFR.} \note{Due to synchronization structures between the two input clocks to the LINFlexD, the write to this register is delayed between 2 to 3 clock cycles of bus clock.}</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CF</name>
              <description>When LINCR1.CCD = 0, the CF bits are read-only and are calculated by hardware.  \newline When LINCR1.CCD = 1, the CF bits can be written by software.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>LINCR2</name>
          <description>The LINCR2 register contains control and status bits related to buffer operations. \note{When accessing LINCR2, each reserved bit should be written with its original reset value.}</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00006000</resetValue>
           <fields>
            <field>
              <name>TBDE</name>
              <description></description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Delimiter length in break field is 1 bit.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Delimiter length in break field is 2 bits.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IOBE</name>
              <description></description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Bit error does not reset LIN state machine.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Bit error resets LIN state machine.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IOPE</name>
              <description></description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Parity error does not reset LIN state machine.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Parity error resets LIN state machine.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WURQ</name>
              <description>Setting WURQ generates a wakeup request. The character sent during wakeup is copied from DATA0. WURQ is reset by hardware when the wakeup character has been transmitted.  \newline WURQ cannot be set in Sleep mode. Software must exit Sleep mode before setting WURQ.  \newline Bit error is not checked when transmitting the wakeup request.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DDRQ</name>
              <description>DDRQ is set by software to stop data reception if the frame does not concern the node. DDRQ is reset by hardware once the LINFlexD ignores the response and moves to Idle state.  \newline For a LIN slave, DDRQ can be set only when LINSR.HRF = 1 and the identifier is software-filtered.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DTRQ</name>
              <description>DTRQ is set by software in slave mode to request the transmission of the LIN data field stored in the buffer data register. DTRQ can be set only when LINSR.HRF = 1 (to ensure that data transmission is requested only after a header reception).  \newline DTRQ is cleared by hardware when the request has been completed, or on abort request or error condition.  \newline In master mode, DTRQ is set by hardware when BIDR.DIR = 1 and header transmission is complete.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ABRQ</name>
              <description>ABRQ is set by software to abort the current transmission. The LINFlexD aborts the transmission at the end of the current bit.  \newline ABRQ is cleared by hardware when the transmission has been aborted. \newline ABRQ can abort a wakeup request and can also be used in UART mode.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HTRQ</name>
              <description>HTRQ is set by software to request the transmission of a LIN header.  \newline HTRQ is cleared by hardware when the request has been completed or on abort request.  \newline HTRQ has no effect in UART mode. \note{In master mode, if both HTRQ and ABRQ are set at the same time then ABRQ has no effect. Similarly, in slave mode after header reception, if DTRQ and ABRQ are simultaneously set then ABRQ has no effect.}</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BIDR</name>
          <description>The BIDR register contains bits that provide information about the identifier of the transaction and other related information. \note{All the fields (ID, CSS, DIR, DFL) of the BIDR register must be updated when an ID filter (enabled) in Slave mode (Tx or Rx) matches the ID received.}</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFL</name>
              <description>Number of data bytes in the response part of the frame.  \newline DFL = Number of data bytes - 1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIR</name>
              <description>Controls the direction of the data field.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copies it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA registers.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>Identifier part of the identifier field without the identifier parity.  \newline The ID field can be written only in master mode (LINCR1.MME = 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>DATA8</name>
          <description></description>
          <addressOffset>0x38</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATA</name>
              <description>Byte of the data field.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFER</name>
          <description>The IFER register enables/disables the identifier filters. There is one filter active (FACT) bit for each filter.</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>FACT</name>
              <description>One bit for each identifier filter. \newline Software sets FACT[n] to activate the filter n in identifier list mode. \newline In identifier mask mode, FACT[2n+1] have no effect on the corresponding filters as they act as mask for identifier 2n.  \newline FACT[n] can be read in any mode, but can be written only during Initialization mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFMI</name>
          <description>The IFMI register contains the index corresponding to the received identifier. It can be used to read or write the data directly in RAM.</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>IFMI</name>
              <description>Contains the index corresponding to the received identifier.  \newline Upon a filter match with filter x, IFMI[N:0] = x+1. \newline On no match, IFMI is equal to 0x00. \newline IFMI can be used to directly write or read the data in RAM (see \hyperlink{slave-mode}{“Slave Mode”} for details).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFMR</name>
          <description>The IFMR register configures the modes of filters. There is one IFM bit for each pair of filters.</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>IFM</name>
              <description>\begin{itemize}[] \item 0:  Filters 2n and 2n+1 are in identifier list mode. \item 1:  Filters 2n and 2n+1 are in mask mode. Filter 2n+1 is the mask for filter 2n. \end{itemize} IFM[n] can be read in any mode, but can be written only during Initialization mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFCR0</name>
          <description>There is an Identifier Filter Control Register (IFCRn) for each filter. \newline Even-numbered instances of IFCRn (IFCR0, IFCR2, IFCR4, and so on) act as filters in both identifier list and identifier mask modes. \newline Odd-numbered instances of IFCRn (IFCR1, IFCR3, IFCR5, and so on) act as: \begin{itemize}[] \item Filters in identifier list mode. \item A mask for the preceding-numbered register in identifier mask mode. For example, if filters 0 and 1 are configured for identifier mask mode, IFCR1 acts as a mask for IFCR0. \end{itemize} The IFCRn registers are read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFL</name>
              <description>Number of data bytes in the response part of the frame. \newline DFL = Number of data bytes - 1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIR</name>
              <description>Controls the direction of the data field.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copy it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA register.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>Identifier part of the identifier field without the identifier parity.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFCR1</name>
          <description>There is an Identifier Filter Control Register (IFCRn) for each filter. \newline Even-numbered instances of IFCRn (IFCR0, IFCR2, IFCR4, and so on) act as filters in both identifier list and identifier mask modes. \newline Odd-numbered instances of IFCRn (IFCR1, IFCR3, IFCR5, and so on) act as: \begin{itemize}[] \item Filters in identifier list mode. \item A mask for the preceding-numbered register in identifier mask mode. For example, if filters 0 and 1 are configured for identifier mask mode, IFCR1 acts as a mask for IFCR0. \end{itemize} The IFCRn registers are read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFL</name>
              <description>Number of data bytes in the response part of the frame. \newline DFL = Number of data bytes - 1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIR</name>
              <description>Controls the direction of the data field.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copy it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA register.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>Identifier part of the identifier field without the identifier parity.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IFCR2</name>
          <description>There is an Identifier Filter Control Register (IFCRn) for each filter. \newline Even-numbered instances of IFCRn (IFCR0, IFCR2, IFCR4, and so on) act as filters in both identifier list and identifier mask modes. \newline Odd-numbered instances of IFCRn (IFCR1, IFCR3, IFCR5, and so on) act as: \begin{itemize}[] \item Filters in identifier list mode. \item A mask for the preceding-numbered register in identifier mask mode. For example, if filters 0 and 1 are configured for identifier mask mode, IFCR1 acts as a mask for IFCR0. \end{itemize} The IFCRn registers are read-only in Normal mode and can be written only in Initialization mode.</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
