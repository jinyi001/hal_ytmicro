    <peripheral>
      <name>EMU0</name>
      <description>ECC Management Unit</description>
      <groupName>EMU</groupName>
      <prependToName>EMU0_</prependToName>
      <baseAddress>0x40072000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>300</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>EIGCR</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>GEN</name>
              <description>This bit will enable or disable all error injection functions.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Global error injection is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Global error injection is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHCR</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CH1EN</name>
              <description>This field enable or disable channel 1 error injection function. 
Enable channel 1 error injection function should enable this field and EIGCR[GEN]. 
Any write to EICHD1_ADDR, EICHD1_CHKBIT, EICHD1_DATA register will clear this field.
CH1EN is used for SRAM_U.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Channel 1 error injection is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Channel 1 error injection is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CH0EN</name>
              <description>This field enable channel 0 error injection function. 
Enable channel 0 error injection function should enable this field and EIGCR[GEN]. 
Any write to EICHD0_ADDR, EICHD0_CHKBIT, EICHD0_DATA register will clear this field. 
CH0EN is used for SRAM_L.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Channel 0 error injection is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Channel 0 error injection is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

                                <register>
        <name>EICHD0_ADDR</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field defines which address will be injected error when read access. when the ADDR is not 0, error will be injected according to this field's value. if ADDR is 0, Error will be injected at all read access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_CHKBIT</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHKBIT</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the checkbit bus from the target SRAM should be inverted or remain unmodified.\newline   0b - The corresponding bit of the checkbit bus remains unmodified.\newline   1b - The corresponding bit of the checkbit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_DATA</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATA</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data bus from the target SRAM should be inverted or remain unmodified. \newline 0b - The corresponding bit of the databit bus remains unmodified. \newline 1b - The corresponding bit of the databit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


                                <register>
        <name>EICHD1_ADDR</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field defines which address will be injected error when read access. when the ADDR is not 0, error will be injected according to this field's value. if ADDR is 0, Error will be injected at all read access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD1_CHKBIT</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHKBIT</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the checkbit bus from the target SRAM should be inverted or remain unmodified.\newline   0b - The corresponding bit of the checkbit bus remains unmodified.\newline   1b - The corresponding bit of the checkbit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD1_DATA</name>
          <description></description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATA</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data bus from the target SRAM should be inverted or remain unmodified. \newline 0b - The corresponding bit of the databit bus remains unmodified. \newline 1b - The corresponding bit of the databit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


        <register>
        <name>ERIE</name>
          <description></description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIE</name>
              <description>SRAM_L/U Non-Correctable error interrupt enable. bit 16 means SRAM_L, bit 17 means SRAM_U. \newline 0b - SRAM_L/U Non-Correctable Error interrupt is disabled \newline 1b - SRAM_L/U Non-Correctable Error interrupt is enabled</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIE</name>
              <description>SRAM_L/U Single correctable error interrupt enable, bit 0 means SRAM_L, bit 1 means SRAM_U. \newline 0b - SRAM_L/U Single Correctable Error interrupt is disabled \newline 1b - SRAM_L/U Single Correctable Error interrupt is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERIF</name>
          <description></description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIF</name>
              <description>SRAM_L/U Non-Correctable error interrupt flag. bit 16 means SRAM_L, bit 17 means SRAM_U.
NCIF flag is kept when software reset but cleared when POR.
  0b - SRAM_L/U Non-Correctable Error interrupt not detected
  1b - SRAM_L/U Non-Correctable Error interrupt detected</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIF</name>
              <description>SRAM_L/U Single Correctable error interrupt flag, bit 0 means SRAM_L, bit 1 means SRAM_U.
SCIF flag is kept when software reset but cleared when POR.
  0b - SRAM_L/U Single Correctable Error interrupt not detected
  1b - SRAM_L/U Single Correctable Error interrupt detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

                                <register>
        <name>ERINFO0_ADDR</name>
          <description></description>
          <addressOffset>0x110</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field contains the faulting system address of the last recorded ECC event on SRAM_L/U.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO0_SYND</name>
          <description></description>
          <addressOffset>0x114</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SYNDROME</name>
              <description>This field contains the syndrome of the last recorded ECC event on SRAM_L/U</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO0_CNT</name>
          <description></description>
          <addressOffset>0x118</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>For each correctable error event, the EMU increments this field's error count value until the counter reaches its maximum value 0xFF. CNT will not change once it reaches 0xFF and will not wrap even if error occurs.
Read this field to determine the correctable error count value so far.
Write zero to this field to reset the counter. Writing non-zero (or partial zero) values has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


                                <register>
        <name>ERINFO1_ADDR</name>
          <description></description>
          <addressOffset>0x120</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field contains the faulting system address of the last recorded ECC event on SRAM_L/U.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO1_SYND</name>
          <description></description>
          <addressOffset>0x124</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SYNDROME</name>
              <description>This field contains the syndrome of the last recorded ECC event on SRAM_L/U</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO1_CNT</name>
          <description></description>
          <addressOffset>0x128</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>For each correctable error event, the EMU increments this field's error count value until the counter reaches its maximum value 0xFF. CNT will not change once it reaches 0xFF and will not wrap even if error occurs.
Read this field to determine the correctable error count value so far.
Write zero to this field to reset the counter. Writing non-zero (or partial zero) values has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>



      </registers>
