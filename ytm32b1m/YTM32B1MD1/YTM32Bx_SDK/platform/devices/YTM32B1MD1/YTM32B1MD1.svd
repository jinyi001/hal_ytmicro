<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd">
  <vendor>YTMicro</vendor>
  <vendorID>YTMicro</vendorID>
  <name>YTM32B1MD1</name>
  <series></series>
  <version>1.4</version>
  <description>YTM32B1MD1 YTMicro Microcontroller</description>
  <licenseText>YTMicro Microcontroller all rights reserved.</licenseText>
  <cpu>
    <name>CM33</name>
    <revision>r0p4</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>true</fpuPresent>
    <nvicPrioBits>2</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>EFM</name>
      <description>Embedded Flash Module</description>
      <groupName>EFM</groupName>
      <prependToName>EFM_</prependToName>
      <baseAddress>0x40010000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>1024</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00180300</resetValue>
           <fields>
            <field>
              <name>DPD_EN</name>
              <description>This DPD_EN bit determines whether the Flash will enter deep power-down mode when MCU is entering Deepsleep mode.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash will stay active when MCU enters Deepsleep mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash will enter deep power-down mode when MCU enters Deepsleep mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RETRY_CFG</name>
              <description>These RETRY_CFG bits are used for selecting one of four Erase Retry Voltage Level.
0x4: 1st erase retry pulse
0x5: 2nd erase retry pulse
0x6: 3rd erase retry pulse
0x7: 4th - 20th erase retry pulse</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRESCALER</name>
              <description>These PRESCALER bits are used for EFM operation timing control. \newline These bits need to be programmed to half of core frequency. \newline Please use the following equation to calculate the PRESCALER value: \newline PRESCALER = core frequency / 2. \newline Please note that once the core frequency is changed, this field needs to be set to the appropriate value.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PREFETCH_EN</name>
              <description>This PREFETCH_EN bit is used for enabling prefetch read functionality.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RWS</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACCERRIE</name>
              <description>This ACCERRIE bit determines whether the interrupt will be generated if ACCERR flag is asserted.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if ACCERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if ACCERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERRIE</name>
              <description>This UNRECOVERRIE bit determines whether the interrupt will be generated if UNRECOVERR flag is asserted.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if UNRECOVERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if UNRECOVERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERRIE</name>
              <description>This RECOVERRIE bit determines whether the interrupt will be generated if RECOVERR flag is asserted.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if RECOVERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if RECOVERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONEIE</name>
              <description>This DONEIE bit determines whether the interrupt will be generated if DONE flag is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if DONE flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if DONE flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>STS</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000080</resetValue>
           <fields>
            <field>
              <name>BOOT_INFO</name>
              <description>This BOOT_INFO bit indicates whether Flash SoC address remap is enabled.\newline This register bit is reset by System Reset.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash SoC address remap is disabled, SoC boots from flash A side.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash SoC address remap is enabled, SoC boots from flash B side.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUS_KEY_MATCH</name>
              <description>This CUS_KEY_MATCH bit indicates whether Customer Key is matched.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Customer Key is not matched</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Customer Key is matched</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDLE</name>
              <description>This IDLE bit indicates whether Flash is executing a command.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash is currently executing a command</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>No command is currently being executed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FAIL</name>
              <description>This FAIL bit indicates whether the current command is failed. \newline Command fail includes below scenarios: \newline 1.Target program address is not erased. \newline 2.Program verify is failed. \newline 3.Erase verify is failed.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Current command is succeeds</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Current command is fails</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACCERR</name>
              <description>This ACCERR bit indicates whether an access error been detected.  \newline Accerr error includes below scenarios: \newline 1.Access Flash when IDLE is de-asserted. \newline 2.Launch a new command when IDLE is de-asserted. \newline 3.Lack of address or data information before launching the program or erase command.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Access error is not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Access error is detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERR</name>
              <description>This UNRECOVERR bit indicates whether a 2-bit ECC error been detected.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No unrecovery ECC error.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>2-bit ECC error or multi-bit ECC error.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERR</name>
              <description>This RECOVERR bit indicates whether a 1-bit ECC error been detected.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Recovery ecc error is not detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1-bit ECC error is detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONE</name>
              <description>This DONE bit indicates whether the current command is completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Current command is in progress</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Current command is completed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD</name>
              <description>These CMD bits determine which commands are available.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>2</name>
                  <description>Program 64bits</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Program 64bits and then verify</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
                  <description>Erase sector</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>17</name>
                  <description>Erase sector and then verify</description>
                  <value>17</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>18</name>
                  <description>Erase block (only main array)</description>
                  <value>18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>19</name>
                  <description>Erase block and then verify (only main array)</description>
                  <value>19</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
                  <description>Load HCU Key</description>
                  <value>32</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>48</name>
                  <description>Boot Swap</description>
                  <value>48</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64</name>
                  <description>Program NVR</description>
                  <value>64</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>65</name>
                  <description>Erase NVR</description>
                  <value>65</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>66</name>
                  <description>Read NVR</description>
                  <value>66</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING1</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00060012</resetValue>
           <fields>
            <field>
              <name>TPREPROG</name>
              <description>These TPREPROG bits indicate the pre-program time, and the time unit is 0.5us.  
Please use the following equation to calculate TPREPROG value:         
TPREPROG = (2.5 to 3.5) * 2</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TPROG</name>
              <description>These TPROG bits indicate the program time, and the time unit is 0.5us.    
Please use the following equation to calculate TPROG value:     
TPROG = (8 to 10) * 2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING2</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x06407d00</resetValue>
           <fields>
            <field>
              <name>TERASE_RETRY</name>
              <description>These TERASE_RETRY bits indicate the erase-retry time, and the time unit is 0.5us.  
Please use the following equation to calculate TERASE_RETRY value: 
TERASE = (0.8 to 1) * 1000 * 2 
Please note that both erase-retry is only for main array sector erase.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TERASE</name>
              <description>These TERASE bits indicate the erase time, and the time unit is 0.5us.  
Please use the following equation to calculate TERASE value:  
TERASE = (16 to 20) * 1000 * 2 
Please note that both sector erase (not includes erase-retry) and chip erase got the same erase time.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>NVR_ADDR</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NVR_ADDR</name>
              <description>NVR Access Address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>NVR_DATA0</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>EFM_NVR_DATA</name>
              <description>NVR Access data</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>NVR_DATA1</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>EFM_NVR_DATA</name>
              <description>NVR Access data</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT0</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ADDR_PROT</name>
              <description>Each bit protects 8K bytes address area. \newline if the bit is set to 0, the corresponding 8K area is under protection.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT1</name>
          <description></description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ADDR_PROT</name>
              <description>Each bit protects 8K bytes address area. \newline if the bit is set to 0, the corresponding 8K area is under protection.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERR_ADDR</name>
          <description></description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECC_ERR_ADDR</name>
              <description>These bits indicates the current address of Unrecovery Ecc Error</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD_UNLOCK</name>
          <description></description>
          <addressOffset>0x200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD_UNLOCK_KEY</name>
              <description>Please write 0xfd9573f5 before launching any command</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CUS_KEY</name>
          <description></description>
          <addressOffset>0x204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CUS_KEY</name>
              <description>Please write Customer Key (default is 0x4dff32) before any protected NVR operation</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTRL_OVRD</name>
          <description></description>
          <addressOffset>0x300</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DBG_DISABLE</name>
              <description>This bit determines whether the debugger is override disabled.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Debugger is not override disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Debugger is override disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>

    <peripheral>
      <name>REGFILE</name>
      <description></description>
      <groupName>REGFILE</groupName>
      <prependToName>REGFILE_</prependToName>
      <baseAddress>0x40061000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>32</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
