        <name>CH3_CMP</name>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHCMP</name>
              <description>If the channel is enabled (CH_CTRL[CHEN]), when the timer count (CNT) matches this value, TMR asserts the channel interrupt and sets the channel interrupt flag (CH_INT[CHIF]).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>



