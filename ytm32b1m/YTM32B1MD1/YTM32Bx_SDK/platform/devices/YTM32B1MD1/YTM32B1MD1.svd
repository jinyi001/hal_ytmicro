              <access>read-write</access>
            </field>
            <field>
              <name>CH1F</name>
              <description>Channel 1 flag is used for capture mode and compare mode. In capture mode, this flag sets when capture event occurs. In compare mode, this flag sets when counter matches the values. Write 1 to clear the bit.</description>
              <bitOffset>1</bitOffset>
