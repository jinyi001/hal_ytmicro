                <enumeratedValue>
                  <name>4</name>
                  <description>Divide by 5</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>Divide by 6</description>
                  <value>5</value>
