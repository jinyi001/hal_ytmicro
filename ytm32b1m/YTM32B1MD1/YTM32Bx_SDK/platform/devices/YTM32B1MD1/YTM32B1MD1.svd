              <access>read-write</access>
            </field>
            <field>
              <name>CH0PPF</name>
              <description>Capture positive pulse ready flag, write 1 to clear this bit.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
