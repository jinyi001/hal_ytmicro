    <peripheral>
      <name>GPIOE</name>
      <description></description>
      <groupName>GPIO</groupName>
      <prependToName>GPIOE_</prependToName>
      <baseAddress>0x40011400</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>255</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>PDOR</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PDO</name>
              <description>When configured for general-purpose output, it shows the logic level on the corresponding pin.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>PSOR</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PSO</name>
              <description>Writing to this register will update the contents of the corresponding bit in PDOR.
0b - No change.
1b - Corresponding bit in PDOR is set to logic 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>PCOR</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PCO</name>
              <description>Writing to this register will update the contents of the corresponding bit in PDOR.
0b - No change.
1b - Corresponding bit in PDOR is set to logic 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>PTOR</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PTO</name>
              <description>Writing to this register will update the contents of the corresponding bit in PDOR.
0b - No change.
1b - Corresponding bit in PDOR is set to the inverse of its existing logic state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>PDIR</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PDI</name>
              <description>When configured for digital function, it shows the logic level on the corresponding pin. \newline When configured for analog function, it always reads 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>POER</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>POE</name>
              <description>Configure the corresponding pin for output.
0b - Port output disable
1b - Port output enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>PIER</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>PIE</name>
              <description>Configure the corresponding pin for input.
0b - Port input disable
1b - Port input enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

