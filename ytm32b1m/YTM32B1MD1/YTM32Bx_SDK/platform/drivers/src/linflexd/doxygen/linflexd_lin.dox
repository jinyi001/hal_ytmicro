/*!
 * @defgroup linflexd_lin LINFlexD LIN Driver
 * @ingroup linflexd_driver
 * @brief LIN mode driver for the LINFlexD peripheral.
 *
 * ## Key Features
 * - Master and slave node operation
 * - LIN 2.x enhanced checksum and classic checksum
 * - Blocking and non-blocking frame transfer
 * - Hardware ID filters with automatic response for slave mode
 * - Configurable master break field length (hardware selects among discrete lengths: 10–23, 36, or 50 bit times; see linflexd_break_length_t)
 * - Wakeup signal transmission and detection
 * - Timeout detection for header and response
 * - Auto-synchronization for slave mode
 * - Software parity generation and checking
 *
 * ## Configuration
 *
 * Fill a @ref linflexd_user_config_t structure and pass it to
 * LINFlexD_DRV_Init(). Key fields:
 *
 * | Field               | Description                                    |
 * |---------------------|------------------------------------------------|
 * | baudRate            | LIN bus baud rate (typically 9600 or 19200 bps)|
 * | nodeFunction        | true for master, false for slave               |
 * | breakLength         | Master break field length                      |
 * | autobaudEnable      | Enable auto-synchronization (slave only)       |
 * | timeoutEnable       | Enable header/response timeout detection       |
 * | filterCount         | Number of active ID filters (slave only)       |
 * | slaveFilterCfgPtr   | Pointer to filter configuration array          |
 * | classicID           | Array of IDs using classic checksum            |
 *
 * ## Usage Patterns
 *
 * ### Master Transfer (Blocking)
 * @code
 * linflexd_state_t state;
 * linflexd_user_config_t config;
 * LINFlexD_DRV_GetDefaultConfig(true, &config);
 * config.baudRate = 19200U;
 *
 * LINFlexD_DRV_Init(0U, &config, &state);
 *
 * linflexd_frame_t frame;
 * frame.id           = 0x10U;
 * frame.checksumType = LIN_ENHANCED_CHECKSUM;
 * frame.responseType = LIN_MASTER_RESPONSE;
 * frame.dataLength   = 8U;
 * memcpy(frame.data, txData, 8U);
 *
 * LINFlexD_DRV_MasterTransferBlocking(0U, &frame, 100U);
 *
 * LINFlexD_DRV_Deinit(0U);
 * @endcode
 *
 * ### Slave Response (Callback-driven)
 * @code
 * uint8_t s_slaveTxData[8] = {0x11U, 0x22U, 0x33U, 0x44U, 0x55U, 0x66U, 0x77U, 0x88U};
 *
 * void linCallback(uint32_t instance, void *linState) {
 *     linflexd_state_t *state = (linflexd_state_t *)linState;
 *     if (state->currentEventId == LINFlexD_HEADER_RECEIVED_EVENT) {
 *         linflexd_frame_t frame;
 *         frame.id = state->currentId;
 *         frame.checksumType = LINFlexD_DRV_GetChecksumType(instance, frame.id);
 *         frame.responseType = LIN_SLAVE_RESPONSE;
 *         frame.dataLength   = 8U;
 *         memcpy(frame.data, s_slaveTxData, frame.dataLength);
 *         LINFlexD_DRV_SlaveResponse(instance, &frame);
 *     }
 * }
 * @endcode
 *
 * ## API Reference
 *
 * | Group                           | Key Functions                              |
 * |--------------------------------|---------------------------------------------|
 * | Initialization / Deinitialization | LINFlexD_DRV_Init, LINFlexD_DRV_Deinit   |
 * | Master Transfer                | LINFlexD_DRV_MasterTransferBlocking, LINFlexD_DRV_MasterTransfer |
 * | Slave Response                 | LINFlexD_DRV_SlaveResponse                 |
 * | State Management               | LINFlexD_DRV_GoToSleepMode, LINFlexD_DRV_GotoIdleState |
 * | Utility                        | LINFlexD_DRV_ProcessParity, LINFlexD_DRV_GetChecksumType |
 *
 * ## Integration Notes
 * - The application must enable the LINFlexD peripheral clock before calling Init.
 * - Only one mode (LIN or UART) may be active per LINFlexD instance.
 * - For slave nodes, configure ID filters to enable automatic response
 *   to specific frame headers.
 * - Install a callback via LINFlexD_DRV_InstallCallback() to handle
 *   asynchronous events in slave mode.
 *
 * @note LINFlexD_DRV_GetChecksumType() forces classic checksum for reserved IDs
 *       0x3C–0x3F (diagnostic and user-defined per LIN 2.x), regardless of the
 *       configured checksum type and classicID list.
 */