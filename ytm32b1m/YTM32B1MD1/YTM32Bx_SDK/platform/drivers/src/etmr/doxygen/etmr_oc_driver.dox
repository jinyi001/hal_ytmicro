/*!
@defgroup etmr_oc_driver eTMR Output Compare Driver (eTMR_OC)
@ingroup etmr
@details
@brief Output compare mode driver for the eTMR peripheral.

## Overview

The OC (Output Compare) sub-module generates timed output events by
comparing the counter value against per-channel match registers.
Channels can be configured to set, clear, or toggle the output on match.

## Features

- Set, clear, or toggle output on match
- Per-channel VAL0/VAL1 match values
- Match interrupt support
- Software trigger synchronization

## Usage Pattern

@code{.c}
#define ETMR_INST (0U)

etmr_state_t state;
etmr_user_config_t config;

/* Step 1: Initialize common driver */
eTMR_DRV_GetDefaultConfig(&config);
eTMR_DRV_Init(ETMR_INST, &config, &state);

/* Step 2: Configure output compare */
etmr_oc_ch_param_t ocChConfig = {
    .hwChannelId = 0U,
    .chMode = eTMR_OC_TOGGLE_ON_MATCH,
    .comparedValue0 = 1000U,
    .comparedValue1 = 2000U,
    .enableInterrupt = true,
};
etmr_oc_param_t ocParam = {
    .numOfChannels = 1U,
    .maxCountValue = 0xFFFFU,
    .outputChannelConfig = &ocChConfig,
};
eTMR_DRV_InitOutputCompare(ETMR_INST, &ocParam);

/* Step 3: Update match values at runtime */
eTMR_DRV_UpdateOutputCompareChannel(ETMR_INST, 0U, 3000U, 4000U, true);

/* Step 4: De-initialize */
eTMR_DRV_DeinitOutputCompare(ETMR_INST);
eTMR_DRV_Deinit(ETMR_INST);
@endcode

## API Quick Reference

| Function | Description |
|---|---|
| eTMR_DRV_InitOutputCompare() | Configure channels in output compare mode. |
| eTMR_DRV_DeinitOutputCompare() | Disable output compare and reset channels. |
| eTMR_DRV_UpdateOutputCompareChannel() | Update match values for a channel. |

*/
