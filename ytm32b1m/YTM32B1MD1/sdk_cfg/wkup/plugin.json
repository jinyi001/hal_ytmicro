{
    "name": "wkup",
    "type": "driver",
    "srcs": [
        "App.vue"
    ],
    "mode": "raw",
    "label": "WKUP",
    "includes": [
        "./../../YTM32Bx_SDK/platform/drivers/inc/wku_driver.h"
    ],
    "forceEnable": false,
    "generate": [
        "wku_config.c",
        "wku_config.h"
    ],
    "args": [
        "WKU_DRV_InitPinWakeup {{#each this.data}}(0,WKP_PIN_CH_NUM{{@index}},{{this.pinsName}});{{/each}}",
        "WKU_DRV_InitReset {{#each this.data}}(0,&{{this.resetName}});{{/each}}",
        "WKU_DRV_EnableModuleWakeup {{#each this.data}}(0,{{this.moduleId}});{{/each}}"
    ],
    "move": [
        {
            "from": "./../../YTM32Bx_SDK/platform/drivers/inc/wku_driver.h",
            "to": "platform/drivers/inc/wku_driver.h"
        },
        {
            "from": "./../../YTM32Bx_SDK/platform/drivers/src/wku",
            "to": "platform/drivers/src/wku"
        }
    ],
    "sign": ""
}